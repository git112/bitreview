diff --git a/tests/test_service_cache.py b/tests/test_service_cache.py
new file mode 100644
--- /dev/null
+++ b/tests/test_service_cache.py
@@ -0,0 +1,33 @@
+import fakeredis
+from redis.exceptions import ConnectionError as RedisConnectionError
+
+from app.cache.service_cache import ServiceCache
+
+
+def test_cache_miss_then_hit():
+    cache = ServiceCache(fakeredis.FakeRedis(), ttl_seconds=60)
+    assert cache.get(1) is None
+    cache.put(1, {"id": 1, "name": "Physio"})
+    assert cache.get(1) == {"id": 1, "name": "Physio"}
+    assert 0 < cache.client.ttl("service:v1:1") <= 60
+
+
+def test_invalidate_removes_only_that_key():
+    cache = ServiceCache(fakeredis.FakeRedis())
+    cache.put(1, {"id": 1})
+    cache.put(2, {"id": 2})
+    cache.invalidate(1)
+    assert cache.get(1) is None and cache.get(2) == {"id": 2}
+
+
+def test_invalidate_on_update_endpoint(client, make_services, cache):
+    sid = make_services(1)[0].id
+    client.get(f"/services/{sid}")
+    client.put(f"/services/{sid}", json={"name": "Renamed"})
+    assert cache.get(sid) is None
+
+
+def test_redis_down_fails_open(mocker):
+    client = mocker.Mock(get=mocker.Mock(side_effect=RedisConnectionError("down")))
+    assert ServiceCache(client).get(1) is None
