+import json
+import logging
+
+from redis import Redis
+from redis.exceptions import RedisError
+
+from app.core.config import settings
+
+logger = logging.getLogger(__name__)
+
+
+def _key(service_id: int) -> str:
+    return f"service:v1:{service_id}"
+
+
+class ServiceCache:
+    def __init__(self, client: Redis, ttl_seconds: int = settings.CACHE_TTL_SECONDS):
+        self.client = client
+        self.ttl = ttl_seconds
+
+    def get(self, service_id: int) -> dict | None:
+        try:
+            raw = self.client.get(_key(service_id))
+        except RedisError as exc:
+            logger.warning("redis get failed, serving from db: %s", exc)
+            return None
+        return json.loads(raw) if raw else None
+
+    def put(self, service_id: int, data: dict) -> None:
+        try:
+            self.client.set(_key(service_id), json.dumps(data), ex=self.ttl)
+        except RedisError as exc:
+            logger.warning("redis set failed: %s", exc)
+
+    def invalidate(self, service_id: int) -> None:
+        try:
+            self.client.delete(_key(service_id))
+        except RedisError as exc:
+            logger.warning("redis delete failed: %s", exc)
+
+
+_client = Redis.from_url(settings.REDIS_URL)
+
+
+def get_cache() -> ServiceCache:
+    return ServiceCache(_client)
