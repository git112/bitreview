diff --git a/tests/test_services_pagination.py b/tests/test_services_pagination.py
new file mode 100644
--- /dev/null
+++ b/tests/test_services_pagination.py
@@ -0,0 +1,19 @@
+import pytest
+
+
+def test_pages_do_not_overlap(client, make_services):
+    make_services(45)
+    page1 = [s["id"] for s in client.get("/services?page=1&size=20").json()]
+    page2 = [s["id"] for s in client.get("/services?page=2&size=20").json()]
+    page3 = [s["id"] for s in client.get("/services?page=3&size=20").json()]
+    assert len(page1) == 20 and len(page2) == 20 and len(page3) == 5
+    assert not set(page1) & set(page2)
+    assert page2[0] == page1[-1] + 1
+
+
+@pytest.mark.parametrize("query", ["page=0", "size=0", "size=101", "page=-1"])
+def test_pagination_rejects_invalid_params(client, query):
+    assert client.get(f"/services?{query}").status_code == 422
