diff --git a/tests/test_auth.py b/tests/test_auth.py
new file mode 100644
--- /dev/null
+++ b/tests/test_auth.py
@@ -0,0 +1,27 @@
+def _login(client, password="correct-horse"):
+    return client.post("/auth/login", data={"username": "intern@pulse.dev", "password": password})
+
+
+def test_login_success_returns_bearer_token(client, user):
+    r = _login(client)
+    assert r.status_code == 200
+    assert r.json()["token_type"] == "bearer"
+    assert r.json()["access_token"]
+
+
+def test_login_wrong_password_is_401(client, user):
+    r = _login(client, password="wrong")
+    assert r.status_code == 401
+    assert r.headers["WWW-Authenticate"] == "Bearer"
+
+
+def test_me_with_valid_token(client, user):
+    token = _login(client).json()["access_token"]
+    r = client.get("/auth/me", headers={"Authorization": f"Bearer {token}"})
+    assert r.status_code == 200
+    assert r.json()["email"] == "intern@pulse.dev"
+
+
+def test_me_with_tampered_token_is_401(client, user):
+    token = _login(client).json()["access_token"]
+    r = client.get("/auth/me", headers={"Authorization": f"Bearer {token[:-2]}xx"})
+    assert r.status_code == 401
